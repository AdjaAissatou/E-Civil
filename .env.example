# Copiez ce fichier en « .env » (jamais commité) et remplissez chaque valeur.
# Générer un secret : openssl rand -hex 24
# (PowerShell : -join ((1..24) | % { '{0:x2}' -f (Get-Random -Max 256) }))

# --- Infrastructure
POSTGRES_PASSWORD=
RABBITMQ_USER=ecivil
RABBITMQ_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Secrets des clients Keycloak (importés dans le realm au premier démarrage)
PORTAIL_CLIENT_SECRET=
DEMANDE_SERVICE_SECRET=
DOCUMENT_SERVICE_SECRET=

# --- Premier administrateur E-Civil (mot de passe temporaire, à changer à la première connexion)
ECIVIL_ADMIN_EMAIL=
ECIVIL_ADMIN_MOT_DE_PASSE=

# --- Adresse publique du portail (retour PayDunya, liens des emails, QR code)
ECIVIL_URL_PUBLIQUE=http://localhost:8080

# --- PayDunya (https://app.paydunya.com, onglet « Intégrez notre API »)
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- Emails (Gmail : « mot de passe d'application » ; laisser MAIL_HOST vide pour désactiver)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EXPEDITEUR=
