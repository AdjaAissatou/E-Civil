# Copiez ce fichier en « .env » (jamais commité) et remplissez les valeurs.

# --- PostgreSQL
ECIVIL_DB_URL=jdbc:postgresql://localhost:5432/ecivil
ECIVIL_DB_USER=postgres
ECIVIL_DB_PASSWORD=
REGISTRE_DB_URL=jdbc:postgresql://localhost:5432/registre_central
REGISTRE_DB_USER=postgres
REGISTRE_DB_PASSWORD=

# --- Clé partagée entre le portail et le registre central (32 caractères minimum)
# Générer : openssl rand -hex 32   (ou PowerShell : -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
REGISTRE_API_KEY=
REGISTRE_URL=http://localhost:8081

# --- Premier administrateur (créé au premier démarrage, mot de passe de 12 caractères minimum)
ECIVIL_ADMIN_EMAIL=
ECIVIL_ADMIN_MOT_DE_PASSE=

# --- Adresse publique du portail (liens des emails, retour PayDunya, QR code)
ECIVIL_URL_PUBLIQUE=http://localhost:8080

# --- PayDunya : clés de l'application créée sur https://app.paydunya.com (onglet « Intégrez notre API »)
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- Emails (Gmail : utiliser un « mot de passe d'application », jamais le mot de passe du compte)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EXPEDITEUR=
