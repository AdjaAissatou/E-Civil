classDiagram
    direction TB

    class Personne {
        -int idPersonne
        -String prenom
        -String nom
        -String sexe
        -Date dateNaissance
        -String lieuNaissance
        -String profession
        -String residence
    }

    class Utilisateur {
        -int idUtilisateur
        -Date dateInscription
        -String numeroTelephone
        -String numeroPieceIdentite
        +aLaPermission(code : String) boolean
        +roles() List~Role~
    }

    class Compte {
        -int idCompte
        -String email
        -String motDePasseHache
        -boolean actif
        +seConnecter(email, motDePasse) boolean
        +desactiver() void
    }

    class Profil {
        -int idProfil
        -String libelle
        -String description
        -String paysResidence
        +ajouterRole(role : Role) void
        +retirerRole(role : Role) void
    }

    class Role["Rôle"] {
        -int idRole
        -String code
        -String libelle
        -String description
        +accorder(permission : Permission) void
        +revoquer(permission : Permission) void
        +autorise(code : String) boolean
    }

    class Permission {
        -int idPermission
        -String code
        -String description
        -String avantage
        -String interdiction
    }

    class ProfilRole {
        <<association>>
        -Date dateAttribution
    }

    class RolePermission {
        <<association>>
        -Date dateAttribution
    }

    Personne <|-- Utilisateur : est une
    Utilisateur "1" -- "1" Compte : possède
    Utilisateur "0..*" --> "1" Profil : appartient à
    Profil "1" -- "1..*" ProfilRole
    ProfilRole "0..*" -- "1" Role
    Role "1" -- "0..*" RolePermission
    RolePermission "0..*" -- "1" Permission
